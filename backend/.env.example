# AFRICAN INTELLIGENCE CORE - example configuration. FICTITIOUS VALUES ONLY.
# Copy to .env (never committed) or inject through the orchestrator's secret store.
# Every secret also accepts a *_FILE variant (e.g. AIC_MASTER_KEY_FILE=/run/secrets/master_key).

AIC_ENV=development                     # development | test | preproduction | production
AIC_DATABASE_URL=postgresql+psycopg://aic_app:CHANGE_ME@localhost:5432/aic?sslmode=disable
# Migrations run with a separate, more privileged role:
AIC_MIGRATION_DATABASE_URL=postgresql+psycopg://aic_migrator:CHANGE_ME@localhost:5432/aic?sslmode=disable

# JWT signing keys "kid:secret" (>= 32 chars each). Several keys allow rotation.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
AIC_JWT_KEYS=k2026a:REPLACE_WITH_RANDOM_48_BYTES_URLSAFE_VALUE_000000
AIC_JWT_ACTIVE_KID=k2026a

# 32-byte master key, base64. In production, prefer an HSM/KMS-backed KeyProvider.
# Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
AIC_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTES=

AIC_INSTITUTION_NAME=AFRICAN INTELLIGENCE CORE
AIC_COUNTRY_CODE=XX

AIC_ACCESS_TTL=600
AIC_REFRESH_TTL=28800
AIC_STEP_UP_TTL=300
AIC_MAX_FAILED_LOGINS=5
AIC_LOCKOUT_MINUTES=30
AIC_RATE_LIMIT_AUTH=10
AIC_RATE_LIMIT_DEFAULT=240
AIC_TRUSTED_PROXY_COUNT=1               # number of reverse proxies in front of the API

AIC_OFFLINE_MAX_CLASSIFICATION_RANK=1
AIC_OFFLINE_TTL_HOURS=24

# Optional connectors (leave empty to disable)
AIC_OIDC_ISSUER=
AIC_OIDC_AUDIENCE=
AIC_OIDC_JWKS_URL=
AIC_MISP_URL=
AIC_MISP_API_KEY=
AIC_LLM_ENDPOINT=
AIC_LLM_MAX_CLASSIFICATION_RANK=0
